 #endif
@@ -181,6 +184,15 @@ void BOARD_ADC_GetBatteryInfo(uint16_t *pVoltage, uint16_t *pCurrent)
 void BOARD_Init(void)
 {
     BOARD_GPIO_Init();
+#ifdef ENABLE_HFNODE
+    // The processor's reset (the watchdog's, after a hang or a stop that failed)
+    // does not reset the BK4819, so a carrier on then stays on until BK4819_Init
+    // resets the chip, after the display's start-up delays below (about 0.2 s).
+    // Reset it now, as soon as its pins are set up; BK4819_Init resets it again.
+    // Just after power-on the chip may not take this, and nothing is on the air.
+    BK4819_WriteRegister(BK4819_REG_00, 0x8000);
+    BK4819_WriteRegister(BK4819_REG_00, 0x0000);
+#endif
     BACKLIGHT_InitHardware();
     BOARD_ADC_Init();
 #ifdef ENABLE_VOICE
